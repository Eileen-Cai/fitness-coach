# Base URL of the n8n instance that hosts the Fitness Coach webhook.
#   Local dev:   http://localhost:5678
#   Production:  your public n8n URL (ngrok static domain, Cloudflare Tunnel, or a host)
N8N_WEBHOOK_BASE_URL=http://localhost:5678

# Webhook path from the workflow. Optional — defaults to "fitness-coach".
N8N_WEBHOOK_PATH=fitness-coach

# Optional. Sent as the Authorization header if you later add auth to the webhook.
# N8N_WEBHOOK_TOKEN=
